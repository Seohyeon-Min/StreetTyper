    - target: {fileID: 4928418273388315765, guid: cfdb8fb844c13094d9d0fe33a2ec9bfe, type: 3}
      propertyPath: slides.Array.data[0].sentences.Array.data[0].text
      value: "\uC232\uC18D\uC758 \uAC70\uB300 \uC6A9 '\uB9C8\uADF8\uB098 \uB9C8\uD14C\uB974'\uC5D0\uAC8C
        \uAE38\uB7EC\uC9C4 \uC778\uAC04 \uC544\uC774, \uB370\uBBF8."
      objectReference: {fileID: 0}
    - target: {fileID: 4928418273388315765, guid: cfdb8fb844c13094d9d0fe33a2ec9bfe, type: 3}
      propertyPath: slides.Array.data[0].sentences.Array.data[1].text
      value: "\"\uC5C4\uB9C8, \uC800\uB3C4 \uC774\uC81C \uC5B4\uC5FF\uD55C \uC131\uCCB4\uB85C
        \uC778\uC815\uBC1B\uACE0 \uC2F6\uC5B4\uC694!\""
      objectReference: {fileID: 0}
    - target: {fileID: 4928418273388315765, guid: cfdb8fb844c13094d9d0fe33a2ec9bfe, type: 3}
      propertyPath: slides.Array.data[0].sentences.Array.data[2].text
      value: "\"\uADF8\uB807\uB2E4\uBA74 \uB124 \uB610\uB798\uC758 \uB4DC\uB798\uACE4
        \uC5F4 \uB9C8\uB9AC\uB97C \uBAA8\uB450 \uAEBE\uACE0 \uB3CC\uC544\uC624\uB108\uB77C.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4928418273388315765, guid: cfdb8fb844c13094d9d0fe33a2ec9bfe, type: 3}
      propertyPath: slides.Array.data[0].sentences.Array.data[3].text
      value: "'\uB9C8\uD14C\uB974'\uC758 \uC774\uB984\uC5D0 \uBD80\uB044\uB7FD\uC9C0
        \uC54A\uC740 \uC874\uC7AC\uAC00 \uB418\uAE30 \uC704\uD574,"
      objectReference: {fileID: 0}
    - target: {fileID: 4928418273388315765, guid: cfdb8fb844c13094d9d0fe33a2ec9bfe, type: 3}
      propertyPath: slides.Array.data[0].sentences.Array.data[4].text
      value: "\uC778\uAC04 \uC18C\uB140 \uB370\uBBF8\uC758 \uB3C4\uC7A5\uAE68\uAE30\uAC00
        \uC9C0\uAE08 \uC2DC\uC791\uB41C\uB2E4!"
      objectReference: {fileID: 0}
    - target: {fileID: 4928418273388315765, guid: cfdb8fb844c13094d9d0fe33a2ec9bfe, type: 3}
